# Copy to .env (gitignored) and fill in.
# The agents run on OpenAI. Without OPENAI_API_KEY the app still runs, using the
# deterministic stub agent instead.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Daily LLM token budget (default 4500000, under the 5M/day gpt-5-mini limit). Once spent,
# the agents give a canned reply until midnight Europe/Tallinn.
APP_DAILY_TOKEN_BUDGET=4500000

# Reasoning effort per agent (minimal, low, medium, high). Lower is faster and
# uses fewer tokens.
# AGENT_REASONING_ADVISOR=low
# AGENT_REASONING_VERIFIER=low

# Frontend mock API for development before backend authentication is ready.
# Each developer can enable it locally in their root .env file.
NUXT_PUBLIC_MOCK_API=false
