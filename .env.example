# Copy to .env (gitignored) and fill in.
# AI_PROVIDER picks the LLM behind the agents: anthropic (default) or openai.
# Only the selected provider's key is used. Without it the app still runs, using the
# deterministic stub agent instead.

AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# For AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Daily LLM token budget (default 4500000, under the 5M/day gpt-5-mini limit). Once spent,
# the agents answer with the stub until midnight Europe/Tallinn.
APP_DAILY_TOKEN_BUDGET=4500000
